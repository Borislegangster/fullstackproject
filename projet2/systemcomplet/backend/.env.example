# GLOBUS ENGINEERING — API (FastAPI). Copier en .env et compléter.
# Les secrets peuvent aussi être saisis dans l'ERP (Administration → Secrets, chiffrés AES-256-GCM) ;
# ils ne sont jamais réaffichés en clair.

ENV=development                      # development | test | staging | production
PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
TIMEZONE=Africa/Douala
LOG_JSON=false
LOG_LEVEL=INFO

# Base de données (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://globus:globus@localhost:5432/globus
REDIS_URL=                            # redis://localhost:6379/0 (temps réel multi-instances, limitation de débit)

# Clés (OBLIGATOIRES en production) :
#   SECRET_KEY : python -c "import secrets; print(secrets.token_urlsafe(64))"
#   MASTER_ENCRYPTION_KEY : python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=
MASTER_ENCRYPTION_KEY=
MASTER_KEY_ID=k1
PREVIOUS_ENCRYPTION_KEYS=             # rotation : kid:clé_base64,kid2:clé2

# Sessions & sécurité
COOKIE_SECURE=false                   # true en production (HTTPS)
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
MFA_ENFORCEMENT=warn                  # warn | enforce (production : enforce)
MFA_REQUIRED_ROLES=ADMIN,DIRECTION,FINANCE
WEBAUTHN_RP_ID=localhost

# Stockage
PUBLIC_MEDIA_DIR=./storage/public_media
PRIVATE_STORAGE_BACKEND=local         # local | s3
PRIVATE_STORAGE_DIR=./storage/private
BACKUP_DIR=./storage/backups
PG_BIN_DIR=                           # dossier de pg_dump / pg_restore si absent du PATH
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=

# E-mail : console | smtp | sendgrid | mailgun
EMAIL_PROVIDER=console
EMAIL_FROM=GLOBUS ENGINEERING <no-reply@globus-engineering.cm>
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Business Platform (Meta) : console | meta
WHATSAPP_PROVIDER=console
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
META_WA_PO_TEMPLATE=globus_bon_de_commande

# SMS : console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Notifications push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# Paiements : sandbox (développement uniquement) | stripe | flutterwave | cinetpay
PAYMENT_PROVIDERS=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# BIM — Autodesk Platform Services
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REGION=US

# IA — Claude (SDK Anthropic). AI_PROVIDER=none : règles déterministes sans appel externe.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
STT_PROVIDER=device                   # device (transcription sur l'appareil) | http (service compatible Whisper)
STT_HTTP_URL=

# Appels audio / vidéo (WebRTC)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                            # turn:turn.exemple.cm:3478?transport=udp,turns:turn.exemple.cm:5349
TURN_SHARED_SECRET=

# Analytics (GA4 Data API, facultatif)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# Worker & intégration web
WORKER_INLINE=true                    # false en production (service worker dédié)
WEB_INTERNAL_URL=                     # ex. http://web:3000 (revalidation ISR)
REVALIDATE_SECRET=
DEMO_SEED_ALLOWED=true                # false en production
