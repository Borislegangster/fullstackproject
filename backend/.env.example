# ─────────────────────────────────────────────────────────────────────────────
# Globus BTP — Backend Environment Variables Template
# Copier ce fichier : cp .env.example .env
# NE JAMAIS committer le fichier .env dans Git !
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME=Globus BTP API
# Mettre à False en production !
DEBUG=True

# ── Base de données ───────────────────────────────────────────
# Développement (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./globus_dev.db
# Production (PostgreSQL) — décommenter et remplir
# DATABASE_URL=postgresql+asyncpg://globus_user:MOT_DE_PASSE_FORT@localhost:5432/globus_prod

# ── Sécurité JWT ──────────────────────────────────────────────
# OBLIGATOIRE : Générer avec la commande suivante :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Utiliser deux valeurs DIFFÉRENTES pour les deux clés !
JWT_SECRET_KEY=CHANGER_CETTE_VALEUR_GENEREE_AVEC_python_secrets
JWT_REFRESH_SECRET_KEY=CHANGER_CETTE_AUTRE_VALEUR_DIFFERENTE_DE_LA_PRECEDENTE

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email SMTP ────────────────────────────────────────────────
# Gmail : Activer "App Password" dans Sécurité du compte Google
# Documentation : https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_app_password_16_caracteres
SMTP_FROM=votre.email@gmail.com

# ── URL du Frontend ───────────────────────────────────────────
# Développement
FRONTEND_URL=http://localhost:5173
# Production (décommenter)
# FRONTEND_URL=https://votre-domaine.com

# ── CORS ──────────────────────────────────────────────────────
# Développement
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production (décommenter)
# CORS_ORIGINS=["https://votre-domaine.com"]

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=200/minute
# Mettre à 1 UNIQUEMENT pour les tests CI (jamais en prod)
RATE_LIMITS_DISABLED=0

# ── Autodesk Platform Services (Bureau d'Études) ─────────────
# Créer une app sur https://aps.autodesk.com/
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# ── Observabilité (Phase 4+) ──────────────────────────────────
# Sentry : créer un projet sur https://sentry.io et coller le DSN
SENTRY_DSN=
# Niveau de log structuré
LOG_LEVEL=INFO

# ── Admin par défaut (seed initial uniquement) ────────────────
ADMIN_EMAIL=admin@votre-domaine.com

# ── Paiement Flutterwave (espace client → facturation) ────────
# Dashboard : https://dashboard.flutterwave.com/  (Settings → API Keys)
FLW_SECRET_KEY=               # FLWSECK_TEST-... (test) ou FLWSECK-... (live)
FLW_PUBLIC_KEY=               # FLWPUBK_TEST-... ou FLWPUBK-...
# Secret Hash IDENTIQUE à celui configuré dans Webhooks (sinon webhook rejeté)
FLW_SECRET_HASH=
FLW_ENVIRONMENT=test          # "test" ou "live"

# ── Stockage Cloud — AWS S3 / Cloudflare R2 (fichiers client & ERP) ──
# Laisser USE_CLOUD_STORAGE=False pour stocker en local (/uploads) en dev.
USE_CLOUD_STORAGE=False
S3_ENDPOINT_URL=              # R2 : https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=auto           # "auto" pour R2, ex "eu-west-3" pour S3
# Base publique (bucket R2 public / domaine perso / CDN) pour les assets
# directement chargeables (photos chantier, logo, médias CMS). Sinon → local.
S3_PUBLIC_BASE_URL=           # ex : https://files.globus-btp.com

# ── Visioconférence WebRTC (Bureau d'Études) ──────────────────
# STUN public par défaut ; fournir un serveur TURN pour traverser
# les NAT/pare-feux des chantiers (4G).
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=                     # ex : turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Observabilité Sentry (optionnel, lu directement) ──────────
# SENTRY_TRACES_RATE=0.1
# SENTRY_ENV=production
